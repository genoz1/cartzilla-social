# Cartzilla hub — copy into DigitalOcean App Platform env vars.
# Never commit real secrets. Prefixed CARTZILLA_ where the value is app-specific.

# --- Core site ---
PORT=8081
SITE_URL=https://cartzillagolfcart.com
GA4_MEASUREMENT_ID=

# --- Supabase (required for publishing + logging) ---
CARTZILLA_SUPABASE_URL=
CARTZILLA_SUPABASE_SERVICE_KEY=

# --- Text AI (OpenAI preferred after Claude → OpenAI migration) ---
OPENAI_API_KEY=
CARTZILLA_OPENAI_MODEL=gpt-4o-mini
# Optional fallback only if OPENAI_API_KEY is unset:
# ANTHROPIC_API_KEY=

# --- Content publishing flags (off until you intentionally enable) ---
CARTZILLA_WRITE_ARTICLES_ENABLED=false
CARTZILLA_WRITE_NEWS_ENABLED=false
CARTZILLA_CHECK_VIDEOS_ENABLED=false
# Master switch for real social API posts (keep false while testing):
CARTZILLA_LIVE_MODE=false

# --- Affiliate (optional; do not invent tags) ---
# When unset, Amazon search CTAs omit the tag= parameter.
CARTZILLA_AMAZON_ASSOCIATE_TAG=

# --- Shopify storefront (PAUSED — keep credentials; do not delete account/DNS) ---
# Shop nav falls back to /category/buying-guides unless this is explicitly true.
CARTZILLA_SHOPIFY_ENABLED=false
CARTZILLA_SHOPIFY_STORE_DOMAIN=
CARTZILLA_SHOPIFY_PUBLIC_DOMAIN=
CARTZILLA_SHOPIFY_CLIENT_ID=
CARTZILLA_SHOPIFY_CLIENT_SECRET=
CARTZILLA_SHOPIFY_API_VERSION=2024-10
# Product social posts (educational / spotlight) only schedule when Shopify is
# enabled AND credentials + AI + Supabase are present.
CARTZILLA_CATEGORY_HOWTO_ENABLED=false

# --- Social platforms (optional; skipped when blank) ---
CARTZILLA_FB_PAGE_ID=
CARTZILLA_FB_PAGE_ACCESS_TOKEN=
CARTZILLA_INSTAGRAM_USER_ID=
CARTZILLA_INSTAGRAM_ACCESS_TOKEN=
CARTZILLA_THREADS_USER_ID=
CARTZILLA_THREADS_ACCESS_TOKEN=
CARTZILLA_PINTEREST_ACCESS_TOKEN=
CARTZILLA_PINTEREST_BOARD_ID=

# --- Optional media ---
YOUTUBE_API_KEY=
CARTZILLA_HERO_IMAGE_URL=
