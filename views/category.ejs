<%- include('partials/header', { pageTitle: categoryLabels[category] + ' — Cartzilla', pageDescription: 'Cartzilla ' + categoryLabels[category] + ' — golf cart articles and guides.', canonicalPath: '/category/' + category, category }) %>

<section class="category-hero">
  <div class="wrap">
    <span class="section-title"><%= categoryLabels[category] %></span>
  </div>
</section>

<main class="wrap">
  <section class="section">
    <% if (articles && articles.length) { %>
    <div class="grid">
      <% articles.forEach(a => { %>
        <a href="/article/<%= a.slug %>" class="card">
          <div class="card-image"><img src="<%= a.image_url || '/img/placeholder.jpg' %>" alt="<%= a.title %>" loading="lazy"></div>
          <h3><%= a.title %></h3>
          <p class="dek-sm"><%= a.dek %></p>
        </a>
      <% }) %>
    </div>
    <% } else { %>
      <p style="padding: 20px 0;">Nothing published in this category yet — check back soon.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
