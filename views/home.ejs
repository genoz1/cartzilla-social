<%- include('partials/header', { pageTitle: 'Cartzilla — Golf Cart News, Tutorials & Buying Guides', pageDescription: 'Golf cart news, tutorials, troubleshooting guides, and buying advice.', canonicalPath: '/' }) %>

<section class="hero">
  <div class="wrap">
    <h1>REAL FIXES. REAL GUIDES.<br><span class="lime">NO FLUFF.</span></h1>
    <p>Golf cart news, tutorials, troubleshooting, and buying advice — written by people who actually work on these things, not generic SEO filler.</p>
    <a href="/category/troubleshooting" class="btn">Start Troubleshooting &rarr;</a>
  </div>
</section>

<div class="value-strip">
  <div class="wrap">
    <div class="value-item"><strong>Owner-Written</strong><span>Not generic filler</span></div>
    <div class="value-item"><strong>Always Free</strong><span>No paywalls, ever</span></div>
    <div class="value-item"><strong>EZGO · Club Car · Yamaha</strong><span>All major brands covered</span></div>
    <div class="value-item"><strong>Real Answers</strong><span>Fixes that actually work</span></div>
  </div>
</div>

<main class="wrap">
  <section class="section">
    <div class="section-head">
      <span class="section-title">Latest</span>
    </div>
    <% if (articles && articles.length) { %>
    <div class="grid">
      <% articles.forEach(a => { %>
        <a href="/article/<%= a.slug %>" class="card">
          <div class="card-image"><img src="<%= a.image_url || '/img/placeholder.jpg' %>" alt="<%= a.title %>" loading="lazy"></div>
          <span class="eyebrow" style="margin: 12px 14px 0;"><%= categoryLabels[a.category] || a.category %></span>
          <h3><%= a.title %></h3>
          <p class="dek-sm"><%= a.dek %></p>
        </a>
      <% }) %>
    </div>
    <% } else { %>
      <p>No articles published yet — check back soon.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
